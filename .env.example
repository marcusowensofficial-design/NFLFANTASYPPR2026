# ==============================================================================
# ESPN FANTASY FOOTBALL 2026 CONFIGURATION
# ==============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit your .env file or share your SWID/espn_s2 cookies.

# Your ESPN League ID (found in your ESPN fantasy league URL: leagueId=XXXXXXX)
ESPN_LEAGUE_ID=

# Fantasy Season (Default: 2026)
ESPN_SEASON=2026

# Optional: Your specific team ID if you want default focus on your team (1-8)
ESPN_TEAM_ID=

# ------------------------------------------------------------------------------
# ESPN Private League Authentication Cookies
# Required ONLY if your league is set to Private.
# If your league is Public, you can leave these blank.
# ------------------------------------------------------------------------------
# SWID cookie: typically formatted as {XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX}
ESPN_SWID=

# espn_s2 cookie: a long string of ~200+ alphanumeric characters
ESPN_S2=

# ------------------------------------------------------------------------------
# FantasyPros API Configuration (Optional)
# Enables real-time Expert Consensus Rankings (ECR), standard deviation volatility, and projections
# ------------------------------------------------------------------------------
FANTASYPROS_API_KEY=

# ------------------------------------------------------------------------------
# Application Settings
# ------------------------------------------------------------------------------
DATABASE_URL=sqlite:///./data/fantasy.db
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
DEBUG=False

